<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>


<VBox spacing="20.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <HBox alignment="CENTER" fillHeight="false" maxHeight="-Infinity" minHeight="-Infinity" nodeOrientation="RIGHT_TO_LEFT" prefWidth="200.0" spacing="5.0" styleClass="sensible_pane">
         <children>
            <TextField fx:id="searchField" promptText="بحث سريع..." HBox.hgrow="SOMETIMES" />
            <Label text="النتائج:" />
            <Label fx:id="resultSizeDisplay" text="0" />
         </children>
      </HBox>
      <StackPane prefWidth="600.0">
         <children>
            <TitledPane fx:id="titledPane" expanded="false" nodeOrientation="RIGHT_TO_LEFT" prefWidth="200.0" text="بحث متقدّم">
               <content>
                  <VBox spacing="10.0">
                     <children>
                        <Label styleClass="underlined" text="بحث باستخدام:" />
                        <ScrollPane fitToHeight="true" fitToWidth="true">
                           <content>
                              <FlowPane fx:id="filtersPane" hgap="5.0" nodeOrientation="RIGHT_TO_LEFT" prefWidth="200.0" styleClass="pane" vgap="5.0">
                                 <padding>
                                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                 </padding>
                              </FlowPane>
                           </content>
                        </ScrollPane>
                        <Label text="شروط النتائج:" />
                        <ScrollPane fitToHeight="true" fitToWidth="true" pannable="true" prefWidth="200.0">
                           <content>
                              <FlowPane fx:id="criteriaPane" hgap="10.0" prefWrapLength="100.0" vgap="10.0">
                                 <padding>
                                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                 </padding>
                              </FlowPane>
                           </content>
                        </ScrollPane>
                        <Label styleClass="underlined" text="تحديد النطاق:" />
                        <ScrollPane fitToHeight="true" fitToWidth="true" pannable="true">
                           <content>
                              <VBox fx:id="rangePane" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" />
                           </content>
                        </ScrollPane>
                     </children>
                  </VBox>
               </content>
               <StackPane.margin>
                  <Insets top="-6.0" />
               </StackPane.margin>
            </TitledPane>
         </children>
      </StackPane>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>
